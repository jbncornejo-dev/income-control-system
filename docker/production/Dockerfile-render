# Stage 1: Build Frontend Assets (Vite / NPM)
FROM node:20-slim AS frontend-builder
WORKDIR /var/www
COPY . /var/www
RUN npm install && npm run build

# Stage 2: Composer Dependencies & PHP Extensions
FROM docker.io/library/php:8.2-fpm AS php-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    unzip \
    libpq-dev \
    libonig-dev \
    libssl-dev \
    libxml2-dev \
    libcurl4-openssl-dev \
    libicu-dev \
    libzip-dev \
    && docker-php-ext-install -j$(nproc) \
    pdo_pgsql \
    pgsql \
    intl \
    zip \
    bcmath \
    soap \
    && apt-get autoremove -y && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /var/www
COPY . /var/www
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer \
    && composer install --no-dev --optimize-autoloader --no-interaction --no-progress --prefer-dist

# Stage 3: Final Combined Production Image (Apache + PHP-FPM + Supervisord)
FROM docker.io/library/php:8.2-fpm AS production

# Install Apache, Supervisor, and Runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    apache2 \
    supervisor \
    libpq-dev \
    libicu-dev \
    libzip-dev \
    libfcgi-bin \
    procps \
    && apt-get autoremove -y && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Configure Apache Modules
RUN a2enmod rewrite proxy proxy_fcgi headers \
    && a2dissite 000-default.conf

# Copy Apache VirtualHost configuration
COPY ./docker/production/apache/vhost.conf /etc/apache2/sites-available/laravel.conf
RUN a2ensite laravel.conf

# Copy PHP configs and compiled extension libraries from php-builder
COPY --from=php-builder /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=php-builder /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/
COPY --from=php-builder /usr/local/bin/docker-php-ext-* /usr/local/bin/

RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY ./docker/common/php-fpm/conf.d/*.conf /usr/local/etc/php-fpm.d/

# Copy Application Code and Assets
COPY --from=php-builder /var/www /var/www
COPY --from=frontend-builder /var/www/public /var/www/public

# Setup Entrypoint and Storage Initializer
COPY ./docker/production/php-fpm/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
COPY ./storage /var/www/storage-init

# Copy Supervisor configuration
COPY ./docker/production/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

WORKDIR /var/www
RUN chown -R www-data:www-data /var/www

EXPOSE 80

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]