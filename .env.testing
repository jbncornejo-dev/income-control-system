# Variables para pruebas (Laravel las carga cuando APP_ENV=testing).
#
# Ojo: en el stack de Podman, compose inyecta .env como variables reales del
# contenedor (env_file), y Laravel no sobrescribe variables reales con los
# archivos .env*. Por eso phpunit.xml fuerza DB_DATABASE=app_testing
# (force=true) y este archivo hace de respaldo para ejecuciones fuera de ese
# contexto (p. ej. CLI local con un entorno propio).
APP_ENV=testing

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=app_testing
DB_USERNAME=nath
DB_PASSWORD=secret